<Window x:Class="QARevit.Addin.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QA Revit — QC Agent Dashboard" Width="1180" Height="780"
        MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" Background="{DynamicResource PageBg}"
        Icon="/QARevit;component/Resources/brand32.png">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QARevit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Header ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Image Source="/QARevit;component/Resources/brand64.png" Width="44" Height="44" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="QA Revit" Foreground="White" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="QC Agent Dashboard  ·  Drawing QA untuk Revit 2025" Foreground="#B6C2D9" FontSize="12" />
                    </StackPanel>
                    <Border x:Name="StageChip" Margin="18,0,0,0" VerticalAlignment="Center" CornerRadius="12"
                            Background="#3314B8A6" BorderBrush="#14B8A6" BorderThickness="1" Padding="10,3" Visibility="Collapsed">
                        <TextBlock x:Name="StageText" Foreground="#5EEAD4" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Click="RunQa_Click" ToolTip="Jalankan ulang pengecekan QA">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/QARevit;component/Resources/dashboard16.png" Width="16" Margin="0,0,6,0" />
                            <TextBlock Text="Refresh QA" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="ImportExcel_Click" ToolTip="Import drawing list Excel">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/QARevit;component/Resources/excel16.png" Width="16" Margin="0,0,6,0" />
                            <TextBlock Text="Import Excel" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Content="Export Excel" Click="ExportRegister_Click"
                            ToolTip="Drawing list (nomor, judul, NOTE, revisi) + hasil QA dalam satu file Excel. Bisa diedit lalu dilampirkan kembali di tab Advice AI." />
                    <Button Style="{StaticResource GhostButton}" Click="Settings_Click" Margin="0" ToolTip="Settings">
                        <Image Source="/QARevit;component/Resources/settings16.png" Width="16" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="20,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="QA Revit v0.3" Foreground="{StaticResource Muted}" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Text="Siap." />
            </DockPanel>
        </Border>

        <Grid Margin="20,16,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== KPI cards ===== -->
            <UniformGrid Rows="1" Columns="5" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL SHEET" Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="TotalText" Text="–" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="di model aktif" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{StaticResource Good}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="PASSED" Style="{StaticResource KpiLabel}" />
                            <TextBlock x:Name="PassedText" Text="–" Style="{StaticResource KpiValue}" Foreground="{StaticResource Good}" />
                            <TextBlock Text="siap issue" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{StaticResource Bad}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="FAILED" Style="{StaticResource KpiLabel}" />
                            <TextBlock x:Name="FailedText" Text="–" Style="{StaticResource KpiValue}" Foreground="{StaticResource Bad}" />
                            <TextBlock Text="perlu diperbaiki" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="PASS RATE" Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="RateText" Text="–" Style="{StaticResource KpiValue}" />
                        <ProgressBar x:Name="RateBar" Style="{StaticResource RateBar}" Value="0" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TEMUAN" Style="{StaticResource KpiLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Background="{StaticResource BadSoft}" CornerRadius="8" Padding="8,4" Margin="0,0,6,0" ToolTip="Error">
                                <TextBlock x:Name="ErrorCount" Text="0" Foreground="{StaticResource Bad}" FontWeight="Bold" FontSize="16" />
                            </Border>
                            <Border Background="{StaticResource WarnSoft}" CornerRadius="8" Padding="8,4" Margin="0,0,6,0" ToolTip="Warning">
                                <TextBlock x:Name="WarnCount" Text="0" Foreground="{StaticResource Warn}" FontWeight="Bold" FontSize="16" />
                            </Border>
                            <Border Background="{StaticResource InfoSoft}" CornerRadius="8" Padding="8,4" ToolTip="Info">
                                <TextBlock x:Name="InfoCount" Text="0" Foreground="{StaticResource Info}" FontWeight="Bold" FontSize="16" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="error · warning · info" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ===== Tabs ===== -->
            <TabControl x:Name="Tabs" Grid.Row="1">
                <TabItem Header="✔  Hasil QA">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <CheckBox x:Name="HideInfoCheck" Content="Sembunyikan Info" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Checked="Filter_Changed" Unchecked="Filter_Changed" />
                                        <Grid Width="240">
                                            <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" ToolTip="Cari nomor sheet / pesan" />
                                            <TextBlock Text="🔍  Cari sheet atau temuan…" Foreground="#98A2B3" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       IsHitTestVisible="False" x:Name="SearchHint" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource DarkButton}" Content="Go To Sheet" Click="GoTo_Click" />
                                        <Button Content="Fix Terpilih" Click="FixSelected_Click" />
                                        <Button Content="Fix Semua Judul" Click="FixAll_Click" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="✦ Fix dengan AI" Click="FixWithAi_Click"
                                                ToolTip="Untuk temuan tanpa Fix otomatis (mis. REV_NOTE kosong): AI mengusulkan isinya, Anda periksa dan terapkan dari tab Register Excel." />
                                        <Button Content="Fix Semua Revisi" Click="FixRevisions_Click"
                                                ToolTip="Samakan centang drawing list, SUB_REV / APVD di kop, dan revision cloud dengan revisi yang menempel di sheet." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataGrid x:Name="IssuesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                                      MouseDoubleClick="GoTo_Click">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="SEVERITY" Width="92">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SeverityBadge}">
                                                    <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" FontSize="11" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="RULE" Binding="{Binding RuleId}" Width="110" />
                                    <DataGridTextColumn Header="SHEET" Binding="{Binding SheetNumber}" Width="210" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="TEMUAN" Binding="{Binding Message}" Width="2*" ElementStyle="{StaticResource WrapText}" />
                                    <DataGridTextColumn Header="ADVICE" Binding="{Binding Advice}" Width="2*" ElementStyle="{StaticResource WrapText}" Foreground="#475467" />
                                    <DataGridTextColumn Header="AUTO FIX" Binding="{Binding FixValue}" Width="*" Foreground="#0F9488" ElementStyle="{StaticResource WrapText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <TabItem Header="▦  Register Excel">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock x:Name="RegisterInfo" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"
                                               Text="Import drawing list Excel (format SheetLink/GUID atau manual: DRAWING NUMBER + NAMA DRAWING) untuk membandingkan register dengan model." />
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <TextBlock Text="Ganti stage ke" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
                                            <ComboBox x:Name="StageCombo" Width="190" DisplayMemberPath="Label" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                                            <Button Content="Preview" Click="PreviewStage_Click" />
                                            <Button Content="Export Register…" Click="ExportRegister_Click" Margin="0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource PrimaryButton}" Content="Terapkan ke Revit" Click="ApplyRegister_Click" />
                                            <TextBlock Text="Kop sheet baru" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{StaticResource Muted}" />
                                            <ComboBox x:Name="NewSheetKopCombo" Width="230" DisplayMemberPath="Label" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                                      ToolTip="Dipakai untuk sheet baru dari Excel. Kolom KOP / TITLE BLOCK di Excel (jika ada) lebih diutamakan." />
                                            <Button Content="Pilih Semua" Click="SelectAllChanges_Click" />
                                            <Button Content="Kosongkan" Click="ClearChanges_Click" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="DiffGrid" AutoGenerateColumns="False" CanUserAddRows="False" MouseDoubleClick="DiffGoTo_Click">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="36" />
                                    <DataGridTemplateColumn Header="JENIS" Width="140" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource KindBadge}">
                                                    <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" FontSize="11" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="NOMOR" Binding="{Binding Number}" Width="200" IsReadOnly="True" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="NOMOR BARU" Binding="{Binding NewNumber}" Width="200" IsReadOnly="True" Foreground="#0F9488" />
                                    <DataGridTextColumn Header="JUDUL" Binding="{Binding Name}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource WrapText}" />
                                    <DataGridTextColumn Header="JUDUL BARU" Binding="{Binding NewName}" Width="*" IsReadOnly="True" Foreground="#0F9488" ElementStyle="{StaticResource WrapText}" />
                                    <DataGridTextColumn Header="KOP (EXCEL)" Binding="{Binding TitleBlock}" Width="150" IsReadOnly="True" ElementStyle="{StaticResource WrapText}" />
                                    <DataGridTextColumn Header="KETERANGAN" Binding="{Binding Message}" Width="1.5*" IsReadOnly="True" ElementStyle="{StaticResource WrapText}" Foreground="#475467" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <TabItem Header="▤  Kop / Title Block">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"
                                               Text="Centang sheet, pilih family kop, lalu Ganti Kop. Centang banyak sekaligus: sorot baris dengan Shift/Ctrl+klik, lalu klik satu kotak centang atau tekan Spasi. Kop lama diganti type-nya sehingga posisi dan isi parameter tetap; sheet tanpa kop diberi kop baru." />
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Right" Width="220">
                                            <TextBox x:Name="KopSearchBox" TextChanged="KopFilter_Changed" />
                                            <TextBlock x:Name="KopSearchHint" Text="🔍  Cari sheet / kop…" Foreground="#98A2B3" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Kop baru" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
                                            <ComboBox x:Name="KopCombo" Width="260" DisplayMemberPath="Label" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="Ganti Kop Terpilih" Click="ChangeKop_Click" />
                                            <Button Content="Pilih Semua" Click="KopSelectAll_Click" />
                                            <Button Content="Kosongkan" Click="KopClear_Click" />
                                            <TextBlock x:Name="KopCount" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="4,0,12,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="KopGrid" AutoGenerateColumns="False" CanUserAddRows="False" MouseDoubleClick="KopGoTo_Click">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="36" />
                                    <DataGridTextColumn Header="NOMOR SHEET" Binding="{Binding Number}" Width="230" IsReadOnly="True" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="JUDUL" Binding="{Binding Name}" Width="2*" IsReadOnly="True" ElementStyle="{StaticResource WrapText}" />
                                    <DataGridTextColumn Header="KOP SAAT INI" Binding="{Binding TitleBlockDisplay}" Width="1.5*" IsReadOnly="True" Foreground="#475467" ElementStyle="{StaticResource WrapText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <TabItem Header="⟳  Issue / Revisi">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <!-- Issue banyak sheet sekaligus: isi dari kiri ke kanan -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="1 · REVISI" Style="{StaticResource KpiLabel}" Margin="0,0,0,4" />
                                            <ComboBox x:Name="IssueRevCombo" Width="260" DisplayMemberPath="Label" VerticalContentAlignment="Center"
                                                      SelectionChanged="IssueRev_Changed" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="2 · KOLOM SHEET LIST" Style="{StaticResource KpiLabel}" Margin="0,0,0,4" />
                                            <ComboBox x:Name="IssueColCombo" Width="150" DisplayMemberPath="Label" VerticalContentAlignment="Center"
                                                      ToolTip="Dipilih otomatis dari tanggal revisi. Kolom kosong akan diberi judul tanggal revisi." />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="3 · NOTE (BOLEH KOSONG)" Style="{StaticResource KpiLabel}" Margin="0,0,0,4" />
                                            <TextBox x:Name="IssueNoteBox" Width="220" ToolTip="REV_NOTE di kop, mis. CHANGE ROUTE. Kosongkan untuk first issue." />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="4 · APVD" Style="{StaticResource KpiLabel}" Margin="0,0,0,4" />
                                            <TextBox x:Name="IssueApvBox" Width="60" ToolTip="Inisial approver untuk baris revisi ini di kop." />
                                        </StackPanel>
                                        <Button Style="{StaticResource PrimaryButton}" Content="✔ Terapkan Issue" Click="ApplyIssue_Click" VerticalAlignment="Bottom"
                                                ToolTip="Tempel revisi ini ke sheet tercentang, centang kolom sheet list, isi SUB_REV / REV_NOTE / APVD." />
                                        <Button Content="↶ Batalkan Issue" Click="CancelIssue_Click" VerticalAlignment="Bottom"
                                                ToolTip="Kebalikan Terapkan Issue: lepas revisi ini dari sheet tercentang (mis. terlanjur jadi C padahal masih B)." />
                                    </StackPanel>
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Right" Width="220">
                                            <TextBox x:Name="IssueSearchBox" TextChanged="IssueFilter_Changed" />
                                            <TextBlock x:Name="IssueSearchHint" Text="🔍  Cari sheet / status…" Foreground="#98A2B3" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Pilih Semua" Click="IssueSelectAll_Click" />
                                            <Button Content="Kosongkan" Click="IssueClear_Click" />
                                            <Button Style="{StaticResource DarkButton}" Content="Buka Sheet" Click="IssueGoTo_Click" />
                                            <Button Style="{StaticResource DangerButton}" Content="🗑 Hapus Sheet" Click="DeleteSheets_Click" />
                                            <TextBlock Text="Stage" VerticalAlignment="Center" Margin="8,0,8,0" Foreground="{StaticResource Muted}" />
                                            <ComboBox x:Name="IssueStageCombo" Width="170" DisplayMemberPath="Label" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                                            <Button Content="Ganti Stage" Click="IssueStage_Click"
                                                    ToolTip="Ganti kode stage di nomor sheet tercentang, mis. ARW-DWG-BD-… menjadi ARW-DWG-DD-…" />
                                            <TextBlock x:Name="IssueCount" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="4,0,12,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock x:Name="IssueInfo" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,0" />

                                    <Popup x:Name="PickPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="14"
                                                MinWidth="300" MaxWidth="380" Margin="0,2,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="PickTitle" FontWeight="Bold" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="PickHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="PickList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding Checked}" Margin="0,4" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Button Style="{StaticResource PrimaryButton}" Content="Terapkan" Click="PickApply_Click" />
                                                    <Button Content="Batal" Click="PickCancel_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="IssueGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      CellEditEnding="IssueGrid_CellEditEnding">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="36" />
                                    <DataGridTextColumn Header="NOMOR SHEET ✎" Binding="{Binding Number}" Width="220" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="JUDUL ✎" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource WrapText}" />
                                    <DataGridTextColumn Header="NOTE ✎" Binding="{Binding Note}" Width="1.2*" ElementStyle="{StaticResource WrapText}" />
                                    <DataGridTemplateColumn Header="REVISI DI SHEET" Width="1.4*" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource CellButton}" Click="PickRevisions_Click" ToolTip="Klik untuk memilih revisi di sheet ini">
                                                    <TextBlock Text="{Binding Revisions}" TextWrapping="Wrap" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="KOLOM TERCENTANG" Width="1.4*" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource CellButton}" Click="PickColumns_Click" ToolTip="Klik untuk memilih kolom sheet list yang dicentang">
                                                    <TextBlock Text="{Binding Issues}" TextWrapping="Wrap" Foreground="#475467" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="STATUS" Width="170" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource CellButton}" Click="Status_Click" ToolTip="Klik untuk memilih cara menyamakan centang dan revisi">
                                                    <TextBlock Text="{Binding Status}" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <TabItem Header="✦  Advice AI">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Image DockPanel.Dock="Left" Source="/QARevit;component/Resources/ai32.png" Width="28" Height="28" Margin="0,0,10,0" />
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="Bersihkan Chat" Click="ClearChat_Click" />
                                        <Button x:Name="AiButton" Style="{StaticResource PrimaryButton}" Content="✦ Generate Advice AI" Click="AiAdvice_Click" Margin="0" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Rekomendasi Perbaikan" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Text}" />
                                        <TextBlock x:Name="AiInfo" Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border DockPanel.Dock="Bottom" Padding="14,10" Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10">
                                <StackPanel>
                                    <WrapPanel x:Name="QuickPanel" Margin="0,0,0,8">
                                        <Button Content="Apa yang harus dikerjakan dulu?" Click="Quick_Click" Padding="10,4" FontWeight="Normal" />
                                        <Button Content="Sheet mana yang belum siap issue?" Click="Quick_Click" Padding="10,4" FontWeight="Normal" />
                                        <Button Content="Apa yang bisa diperbaiki sekali klik?" Click="Quick_Click" Padding="10,4" FontWeight="Normal" />
                                        <Button Content="Ringkas untuk laporan ke atasan" Click="Quick_Click" Padding="10,4" FontWeight="Normal" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Content="⬇ Export Excel" Click="ExportRegister_Click" Padding="10,4"
                                                ToolTip="Edit file ini di Excel (nomor, judul, NOTE, tanda x di kolom revisi), lalu lampirkan kembali di sini." />
                                        <Button Style="{StaticResource DarkButton}" Content="📎 Lampirkan Excel" Click="AttachExcel_Click" Padding="10,4"
                                                ToolTip="Pilih Excel yang sudah diedit (atau seret filenya ke area chat). Perbedaannya dengan model ditampilkan dulu sebelum diterapkan." />
                                    </WrapPanel>
                                    <DockPanel>
                                    <Button DockPanel.Dock="Right" x:Name="SendButton" Style="{StaticResource DarkButton}" Content="Kirim ➤" Click="Send_Click" Margin="8,0,0,0" />
                                    <Grid>
                                        <TextBox x:Name="ChatInput" Height="34" KeyDown="ChatInput_KeyDown" TextChanged="ChatInput_TextChanged" />
                                        <TextBlock x:Name="ChatHint" Text="Tanya AI tentang hasil QA ini, lalu Enter…"
                                                   Foreground="#98A2B3" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </Grid>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <ScrollViewer x:Name="AdviceScroll" VerticalScrollBarVisibility="Auto" Background="#F8FAFC" AllowDrop="True" Drop="Advice_Drop">
                                <StackPanel Margin="16,14" MaxWidth="900" HorizontalAlignment="Left">
                                    <StackPanel x:Name="RulePanel" />
                                    <StackPanel x:Name="ChatPanel" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
