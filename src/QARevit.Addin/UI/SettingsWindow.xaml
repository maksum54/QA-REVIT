<Window x:Class="QARevit.Addin.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QA Revit — Settings" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12"
        Background="{DynamicResource PageBg}" Icon="/QARevit;component/Resources/brand32.png">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QARevit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel>
        <Border Background="{StaticResource HeaderBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <Image Source="/QARevit;component/Resources/settings32.png" Width="30" Height="30" />
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="Settings" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="AI advice dan konfigurasi standar penomoran proyek" Foreground="#B6C2D9" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="18,16,18,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Image Source="/QARevit;component/Resources/ai32.png" Width="20" Height="20" Margin="0,0,8,0" />
                    <TextBlock Text="AI Advice" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Provider" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    <ComboBox x:Name="ProviderCombo" Grid.Column="1" Margin="0,4" SelectionChanged="Provider_Changed">
                        <ComboBoxItem Content="Claude (Anthropic)" Tag="Anthropic" />
                        <ComboBoxItem Content="Custom (OpenAI-compatible)" Tag="OpenAiCompatible" />
                    </ComboBox>
                    <TextBlock Grid.Row="1" Text="Base URL" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    <TextBox x:Name="BaseUrlBox" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                    <TextBlock Grid.Row="2" Text="Model" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    <TextBox x:Name="ModelBox" Grid.Row="2" Grid.Column="1" Margin="0,4" />
                    <TextBlock Grid.Row="3" Text="API Key" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    <PasswordBox x:Name="KeyBox" Grid.Row="3" Grid.Column="1" Margin="0,4" />
                </Grid>
                <Border Background="#F0FDFA" CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
                    <TextBlock Foreground="#0F766E" TextWrapping="Wrap"
                               Text="🔒 API key dienkripsi (Windows DPAPI) di %AppData%\QARevit. Yang dikirim ke AI hanya nomor/judul sheet dan temuan QA, bukan file model." />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Tes Koneksi" Click="Test_Click" />
                    <TextBlock x:Name="TestResult" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="18,12,18,0">
            <StackPanel>
                <TextBlock Text="Konfigurasi Proyek" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="File JSON: kode proyek, stage (CD → BD → DD → DC), kode sistem, jenis gambar, dan daftar typo. Kosong = bawaan." />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Buat dari Bawaan…" Click="CreateConfig_Click" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Pilih…" Click="BrowseConfig_Click" Margin="8,0,0,0" />
                    <TextBox x:Name="ConfigBox" />
                </DockPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,16,18,18">
            <Button Content="Batal" Width="90" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" Content="Simpan" Width="100" IsDefault="True" Click="Save_Click" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
