<Window x:Class="QARevit.Addin.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QA Revit — Settings" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12">
    <StackPanel Margin="14">
        <TextBlock Text="AI Advice" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Provider" VerticalAlignment="Center" />
            <ComboBox x:Name="ProviderCombo" Grid.Column="1" Margin="0,3" SelectionChanged="Provider_Changed">
                <ComboBoxItem Content="Claude (Anthropic)" Tag="Anthropic" />
                <ComboBoxItem Content="Custom (OpenAI-compatible)" Tag="OpenAiCompatible" />
            </ComboBox>
            <TextBlock Grid.Row="1" Text="Base URL" VerticalAlignment="Center" />
            <TextBox x:Name="BaseUrlBox" Grid.Row="1" Grid.Column="1" Margin="0,3" />
            <TextBlock Grid.Row="2" Text="Model" VerticalAlignment="Center" />
            <TextBox x:Name="ModelBox" Grid.Row="2" Grid.Column="1" Margin="0,3" />
            <TextBlock Grid.Row="3" Text="API Key" VerticalAlignment="Center" />
            <PasswordBox x:Name="KeyBox" Grid.Row="3" Grid.Column="1" Margin="0,3" />
        </Grid>
        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="API key disimpan terenkripsi (Windows DPAPI) di %AppData%\QARevit, tidak masuk ke file model. Yang dikirim ke AI hanya nomor/judul sheet dan temuan QA." />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Tes Koneksi" Padding="10,3" Click="Test_Click" />
            <TextBlock x:Name="TestResult" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="400" />
        </StackPanel>

        <Separator Margin="0,12" />
        <TextBlock Text="Konfigurasi Proyek" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="File JSON berisi kode proyek, stage (CD → BD → DD → DC), kode sistem, jenis gambar, dan daftar typo. Kosong = bawaan." />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Buat dari Bawaan…" Padding="8,3" Margin="6,0,0,0" Click="CreateConfig_Click" />
            <Button DockPanel.Dock="Right" Content="Pilih…" Padding="8,3" Margin="6,0,0,0" Click="BrowseConfig_Click" />
            <TextBox x:Name="ConfigBox" VerticalContentAlignment="Center" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Simpan" Width="90" IsDefault="True" Click="Save_Click" Margin="0,0,6,0" />
            <Button Content="Batal" Width="90" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
